# ── Shared login ──────────────────────────────────────────────────────────────
# Must be IDENTICAL to the JWT_SECRET used by the quarc-auth service (see
# Quarc_Store/auth/.env) and by every other Quarc app's .env — that's what makes
# one login work across every Quarc app.
JWT_SECRET=change-this-to-a-long-random-string

# Must match quarc-auth's SECURE_COOKIE (true in production, behind HTTPS).
SECURE_COOKIE=true

# ── Garmin credentials at rest ────────────────────────────────────────────────
# Encrypts each person's Garmin Connect email + password in the database.
# Generate once and keep it (a backup carries it; losing it means everyone has to
# re-enter their Garmin login):
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without Python:
#   docker run --rm python:3.12-slim sh -c "pip -q install cryptography && python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'"
CREDENTIALS_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=sport
POSTGRES_USER=sport
POSTGRES_PASSWORD=change-me

# ── Sync behaviour ────────────────────────────────────────────────────────────
# How many days to backfill on a person's first sync (3650 = ~10 years)
SYNC_BACKFILL_DAYS=3650

# How often to re-sync in seconds (3600 = every hour)
SYNC_INTERVAL_SECONDS=3600

# ── Strava (optional) ─────────────────────────────────────────────────────────
# Lets people connect their Strava account. Create ONE API application for this server at
# https://www.strava.com/settings/api :
#   - Authorization Callback Domain: the host name of this server (quarcnet0.tail84500c.ts.net)
#   - copy the Client ID and Client Secret here
# A new Strava app can connect 1 athlete (you) until you raise its capacity to 10 on that page;
# more than 10 needs Strava's review. Leave empty and the Strava section says it isn't set up.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Where people reach this server (used for Strava's redirect back):
PUBLIC_URL=https://quarcnet0.tail84500c.ts.net:4007
